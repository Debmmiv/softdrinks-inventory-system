# ==============================================================
# Environment Configuration - Soft Drinks Inventory System
# ==============================================================

# MongoDB Atlas Connection String URI (for Server API Routes & Admin CLI)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/softdrinks_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/softdrinks_db?retryWrites=true&w=majority

# JWT Secret for Signing and Verifying Authentication Tokens
JWT_SECRET=super_secret_jwt_key_here

# Client API Base URL
# For Web / Simulator testing:
EXPO_PUBLIC_API_URL=http://localhost:8081/api
# For physical Android device on LAN, set to your computer's local IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8081/api
